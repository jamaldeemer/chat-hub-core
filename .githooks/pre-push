#!/bin/sh
# chat-hub-core: a push to the main branch is a release. It's refused unless
# - (level 2) CI passed on that exact commit (`ci.passed` in .claude/chat-hub.json), and
# - (level 2) no fix it ships is still listed in any worktree's to-check file.
# Pushing any other branch is never blocked. RELEASE_UNTESTED=1 skips the CI check only.
cfg=.claude/chat-hub.json
[ -f "$cfg" ] || exit 0
command -v node >/dev/null 2>&1 || { echo "chat-hub-core pre-push: node not found, not checking." >&2; exit 0; }
get() { node -e "const c=require('./$cfg');const v=($1);process.stdout.write(v==null?'':String(v))"; }
level=$(get 'c.level'); main=$(get 'c.branches?.main ?? "main"'); passed=$(get 'c.ci?.passed')
tocheck=$(get 'c.fixes?.toCheck ?? ".claude/issues-to-check.md"')
[ "${level:-0}" -ge 2 ] || exit 0
zero=0000000000000000000000000000000000000000
blocked=0
waiting=$(git worktree list --porcelain | sed -n 's/^worktree //p' | while read -r wt; do
  [ -f "$wt/$tocheck" ] && grep -oE -- '- #[0-9]+' "$wt/$tocheck" | grep -oE '[0-9]+'
done | sort -u)
while read -r _ local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/$main" ] || continue
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha" 2>/dev/null; then range="$remote_sha..$local_sha"; else range="$local_sha"; fi
  for n in $(git log --format=%B "$range" | grep -oiE '(fix|fixes|fixed|close|closes|closed|resolve|resolves|resolved) #[0-9]+' | grep -oE '[0-9]+' | sort -u); do
    if echo "$waiting" | grep -qx "$n"; then echo "Push to $main blocked: #$n is still waiting to be checked ($tocheck)." >&2; blocked=1; fi
  done
  short=$(git rev-parse --short "$local_sha")
  if [ -n "$RELEASE_UNTESTED" ]; then echo "RELEASE_UNTESTED set: not checking CI on $short." >&2
  elif [ -z "$passed" ]; then echo "Push to $main blocked: no ci.passed command in $cfg." >&2; blocked=1
  else
    # 1 = passed, 0 (and exit 0) = not passed, anything else = couldn't ask. Its own errors stay visible.
    out=$(SHA=$local_sha sh -c "$passed" </dev/null); rc=$?
    out=$(printf %s "$out" | tr -d '[:space:]')
    if [ "$out" = 1 ]; then :
    elif [ "$out" = 0 ] && [ "$rc" -eq 0 ]; then
      echo "Push to $main blocked: CI hasn't passed on $short. Push it as the release branch, wait for green, then push that same commit." >&2; blocked=1
    else
      echo "Push to $main blocked: couldn't ask CI whether $short passed (ci.passed failed or gave no answer). Check the command in $cfg, or set RELEASE_UNTESTED=1 if CI itself is down." >&2; blocked=1
    fi
  fi
done
exit $blocked
